[
    {config, [
        #{
            files => ["apps/*/src/**/*.erl"],
            rules => [
                {elvis_style, no_macros, disable},
                %% JMAP property names (RFC 8621) are camelCase on the wire
                {elvis_style, atom_naming_convention, #{
                    ignore => [mailio_filter, mailio_email, mailio_thread],
                    regex => "^[a-z](_?[a-z0-9]+)*(_SUITE)?$"
                }},
                {elvis_text_style, max_line_length, #{limit => 120}},
                %% New in elvis_core 5.x: disabled until the code is reviewed against them
                {elvis_style, prefer_strict_generators, disable},
                {elvis_style, prefer_sigils, disable},
                {elvis_style, consistent_ok_error_spec, disable},
                {elvis_style, abc_size, disable},
                {elvis_style, code_complexity, disable},
                {elvis_style, consistent_variable_naming, disable},
                {elvis_style, no_common_caveats_call, disable},
                {elvis_style, no_init_lists, disable},
                {elvis_style, no_spec_with_records, disable},
                {elvis_style, param_pattern_matching, disable},
                {elvis_style, no_used_ignored_variables, disable},
                {elvis_style, state_record_and_type, disable},
                {elvis_style, private_data_types, disable},
                {elvis_style, no_receive_without_timeout, disable},
                %% Protocol clients and the adapters have long functions by nature
                {elvis_style, dont_repeat_yourself, disable},
                {elvis_style, max_function_length, disable},
                {elvis_style, max_function_clause_length, disable},
                {elvis_style, max_module_length, disable},
                {elvis_style, no_god_modules, disable},
                {elvis_style, no_deep_nesting, disable},
                {elvis_style, no_if_expression, disable},
                {elvis_style, no_catch_expressions, disable},
                {elvis_style, no_throw, disable},
                {elvis_style, no_invalid_dynamic_calls, disable},
                %% Style choices: comparisons such as `X =:= true` guard against non-boolean
                %% JSON input, `maybe` blocks sit inside `reply(...)`, and the protocol
                %% clients keep their long fun bodies together
                {elvis_style, no_boolean_in_comparison, disable},
                {elvis_style, no_block_expressions, disable},
                {elvis_style, max_anonymous_function_length, disable},
                {elvis_style, max_anonymous_function_clause_length, disable},
                {elvis_style, prefer_robot_butt, disable}
            ],
            ruleset => erl_files_strict
        },
        #{
            files => ["apps/*/rebar.config", "rebar.config"],
            %% barrel_mcp is tracked on its main branch, as in the other barrel apps
            rules => [{elvis_project, no_branch_deps, disable}],
            ruleset => rebar_config
        }
    ]}
].
