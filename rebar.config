{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_unused_vars,
    warn_unused_import,
    warn_export_all
]}.

%% Umbrella: apps/mailio (protocol and MIME library, OTP only),
%% apps/mailio_store (storage, depends on barrel_docdb).
{project_app_dirs, ["apps/*"]}.

%% h1 and h2 (dependencies of barrel_mcp) still use the catch operator.
{overrides, [
    {add, h1, [{erl_opts, [nowarn_deprecated_catch]}]},
    {add, h2, [{erl_opts, [nowarn_deprecated_catch]}]},
    {add, meck, [{erl_opts, [nowarn_deprecated_catch]}]}
]}.

{project_plugins, [
    %% Pinned: rebar3_lint changed how it resolves elvis.config within the
    %% 5.0 range, and plugins are not locked.
    {rebar3_lint, "5.0.4"},
    {erlfmt, "~> 1.7"}
]}.

%% Formatting and lint rules apply to apps/mailio_mcp only; the older apps
%% are not formatted with erlfmt.
{erlfmt, [
    write,
    {files, [
        "apps/mailio_mcp/{src,test}/**/*.{hrl,erl,app.src}",
        "apps/mailio_mcp/config/*.config",
        "apps/mailio_mcp/rebar.config"
    ]}
]}.

%% Callbacks and adapters are called through apply, so unused exports are
%% not reported.
{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    deprecated_function_calls,
    deprecated_functions
]}.

{eunit_opts, [verbose]}.
{cover_enabled, true}.

{ct_opts, [{verbose, true}]}.

{shell, [
    {apps, [mailio_store]}
]}.

{dialyzer, [
    {warnings, [unmatched_returns, error_handling]},
    {plt_apps, all_deps}
]}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_export_all]}
    ]}
]}.
