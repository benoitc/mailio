{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_unused_vars,
    warn_unused_import,
    warn_export_all
]}.

%% barrel_docdb is provided via _checkouts/barrel_docdb (symlink to the
%% sibling working copy) so its live data/ dir and _build are not copied.
{deps, []}.

{eunit_opts, [verbose]}.
{cover_enabled, true}.

{ct_opts, [{verbose, true}]}.

{shell, [
    {apps, [mailio]}
]}.

{dialyzer, [
    {warnings, [unmatched_returns, error_handling]},
    {plt_apps, all_deps}
]}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_export_all]}
    ]}
]}.
