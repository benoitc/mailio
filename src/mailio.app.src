{application, mailio, [
    {description, "JMAP-first Erlang/OTP mail client and mail-processing library"},
    {vsn, "0.1.0"},
    {registered, [mailio_sup]},
    {mod, {mailio_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        public_key,
        ssl,
        barrel_docdb
    ]},
    {env, [
        {data_dir, "data/mailio"},
        {system_db, <<"mailio_system">>}
    ]},
    {modules, []},
    {licenses, ["Apache-2.0"]}
]}.
