{deps, []}.

{project_plugins, [rebar3_hex, rebar3_ex_doc]}.

{hex, [{doc, #{provider => ex_doc}}]}.

{ex_doc, [
    {extras, [
        {"README.md", #{title => "mailio"}},
        {"doc/overview.md", #{title => "Overview"}},
        {"doc/usage.md", #{title => "Use mailio on its own"}}
    ]},
    {main, "readme"},
    {homepage_url, "https://github.com/benoitc/mailio"},
    {groups_for_modules, [
        {"Protocol clients", [mailio_smtp, mailio_pop3, mailio_imap_conn, mailio_imap_proto]},
        {"Messages", [
            mailio_mime,
            mailio_mime_render,
            mailio_mime_decode,
            mailio_rfc5322,
            mailio_html_text
        ]},
        {"Credentials and errors", [mailio_credentials, mailio_error]},
        {"Store support (not covered by the version promise)", [
            mailio_adapter,
            mailio_imap,
            mailio_imap_map,
            mailio_events,
            mailio_registry,
            mailio_id,
            mailio_ascii,
            mailio_credentials_static
        ]}
    ]}
]}.

{profiles, [
    {test, [
        {extra_src_dirs, [{"../../test_support", [{recursive, false}]}]}
    ]}
]}.
