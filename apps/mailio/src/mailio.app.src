    {applications, [
        kernel,
        stdlib,
        crypto,
        public_key,
        ssl
    ]},
    {env, []},
    {modules, []},
    {pkg_name, mailio},
    {licenses, ["Apache-2.0"]},
    {maintainers, ["Benoit Chesneau"]},
    {links, [{"GitHub", "https://github.com/benoitc/mailio"}]}
]}.
