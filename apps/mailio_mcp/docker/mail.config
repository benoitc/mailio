%% Example config for the container. Mount it at /config/mail.config.
%% Secrets are references to environment variables, never literals.
[
    {mailio_mcp, [
        {data_dir, "/data"},
        {accounts, [
            #{
                id => <<"work">>,
                name => <<"Work mail">>,
                incoming => #{
                    protocol => imap, host => "imap.example.com", port => 993, tls => implicit
                },
                outgoing => #{host => "smtp.example.com", port => 587, tls => starttls},
                auth => #{
                    user => <<"me@example.com">>,
                    mechanism => plain,
                    secret => {env, "WORK_MAIL_PASSWORD"}
                },
                identities => [#{address => <<"me@example.com">>, name => <<"Me">>}]
            }
        ]},
        %% Each caller is a principal. The bearer token's `sub' claim must be
        %% one of these ids.
        {principals, [
            #{id => <<"assistant">>, grants => #{<<"work">> => #{role => send, identities => all}}}
        ]},
        %% Signs the tokens of two-step requests; use the same value on every node.
        {request_state_key, {env, "MAILIO_MCP_STATE_KEY"}},
        {http, #{
            port => 8420,
            %% Listen on every interface inside the container. Publish the port
            %% on the host loopback only (see docker-compose.yml) and put TLS in
            %% front, which is what tls_terminated_upstream states.
            ip => "0.0.0.0",
            tls_terminated_upstream => true,
            %% MCP clients are not browsers and send no Origin header
            allowed_origins => any,
            allow_missing_origin => true,
            auth => #{
                provider => barrel_mcp_auth_bearer,
                provider_opts => #{
                    %% HS256 secret of the tokens you issue, at least 32 bytes
                    secret => {env, "MAILIO_MCP_JWT_SECRET"},
                    audience => <<"mailio-mcp">>
                }
            }
        }}
    ]}
].
