%% Two accounts and two callers.
%%   assistant: may read both accounts, draft on both, send only from work.
%%   reader:    may only read the personal account.
%% Incoming and outgoing settings differ per account. The HTTP transport maps
%% the authenticated principal to one of these ids; stdio uses stdio_principal.
[
    {mailio_mcp, [
        {data_dir, "data"},
        {stdio_principal, <<"assistant">>},
        {accounts, [
            #{
                id => <<"work">>,
                name => <<"Work (support alias included)">>,
                incoming => #{
                    protocol => imap, host => "imap.work.example", port => 993, tls => implicit
                },
                outgoing => #{host => "smtp.work.example", port => 587, tls => starttls},
                auth => #{
                    user => <<"me@work.example">>,
                    mechanism => plain,
                    secret => {file, "/run/secrets/work_mail"}
                },
                identities => [
                    #{address => <<"me@work.example">>, name => <<"Me">>},
                    #{address => <<"support@work.example">>, name => <<"Support">>}
                ]
            },
            #{
                id => <<"personal">>,
                name => <<"Personal">>,
                incoming => #{
                    protocol => pop3, host => "pop.personal.example", port => 995, tls => implicit
                },
                outgoing => #{host => "smtp.personal.example", port => 465, tls => implicit},
                auth => #{
                    user => <<"me">>,
                    mechanism => xoauth2,
                    secret => {cmd, "get-oauth-token personal"}
                },
                identities => [#{address => <<"me@personal.example">>, name => <<"Me">>}]
            }
        ]},
        {principals, [
            #{
                id => <<"assistant">>,
                grants => #{
                    <<"work">> => #{role => send, identities => all},
                    <<"personal">> => #{role => draft, identities => all}
                }
            },
            #{
                id => <<"reader">>,
                grants => #{<<"personal">> => #{role => read, identities => []}}
            }
        ]}
    ]}
].
