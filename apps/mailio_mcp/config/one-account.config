%% One account, one implicit principal that may read, draft and send.
%% Secrets are references, never literal passwords: {env, "VAR"}, {file, Path} or {cmd, Command}.
[
    {mailio_mcp, [
        {data_dir, "data"},
        {accounts, [
            #{
                id => <<"work">>,
                name => <<"Work mail">>,
                incoming => #{
                    protocol => imap, host => "imap.example.com", port => 993, tls => implicit
                },
                outgoing => #{host => "smtp.example.com", port => 587, tls => starttls},
                auth => #{
                    user => <<"me@example.com">>,
                    mechanism => plain,
                    secret => {env, "WORK_MAIL_PASSWORD"}
                },
                identities => [#{address => <<"me@example.com">>, name => <<"Me">>}]
            }
        ]}
    ]}
].
